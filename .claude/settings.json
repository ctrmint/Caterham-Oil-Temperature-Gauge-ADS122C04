{
  "permissions": {
    "deny": [
      "Read(~/.config/claude-slack-notify/**)",
      "Edit(~/.config/claude-slack-notify/**)",
      "Bash(cat ~/.config/claude-slack-notify/*)"
    ]
  },
  "hooks": {
    "Notification": [
      {
        "matcher": "idle_prompt|permission_prompt|elicitation_dialog|agent_needs_input",
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PROJECT_DIR}/.claude/hooks/slack-notify.sh",
            "args": ["needs-attention"]
          }
        ]
      }
    ]
  }
}
